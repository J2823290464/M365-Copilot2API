# HTTP bind address (default: 127.0.0.1:4141)
M365_LISTEN=127.0.0.1:4141

# Application/server log timezone. IANA names are supported, for example
# Asia/Shanghai, Asia/Tokyo, Europe/Berlin, or America/New_York.
M365_TIMEZONE=Asia/Shanghai

# OAuth/account cache. Keep this file private and mode 0600.
M365_CONFIG=$HOME/.config/m365-copilot2api/accounts.json

# Required in production; keep stable across restarts.
# M365_MASTER_KEY=replace-with-a-long-random-secret

# Administrator password for direct binary startup only. Docker Compose uses
# secrets/m365_admin_password instead; do not set the default in production.
# M365_ADMIN_PASSWORD=your-strong-password

# Maximum number of simultaneous upstream calls per account.
M365_ACCOUNT_DEFAULT_CONCURRENCY=8

# Optional public identity policy. Disabled by default; set true only for the
# Microsoft gateway channel that needs neutralized public identity output.
M365_PUBLIC_IDENTITY_POLICY=false

# Data and session settings. Leave commented to use application defaults.
# M365_DATA_DIR=$HOME/.config/m365-copilot2api
# M365_SESSION_TTL_MINUTES=120
# M365_CONTEXT_TTL_MINUTES=120
# M365_CONTEXT_SIMILARITY=0.6
# M365_LOG_LEVEL=info

# Cloud conversation cleanup. Set M365_AUTO_CLEANUP to 0/false/no/off to disable.
# M365_AUTO_CLEANUP=true
# M365_AUTO_CLEANUP_INTERVAL_MINUTES=30
# M365_AUTO_CLEANUP_MAX_AGE_HOURS=2
# M365_AUTO_CLEANUP_KEEP_N=100

# Local conversation index cleanup.
# M365_CLEANUP_MODE=after_response
# M365_CLEANUP_KEEP_N=5
# M365_CLEANUP_MAX_AGE_HOURS=24

# Tool planning and request limits.
# M365_TOOL_PLANNING_MODE=router
# M365_MAX_TOOL_CALLS_PER_TURN=1
# M365_MAX_TOOL_ROUNDS=16
# M365_CONTEXT_WINDOW=128000
# M365_AGENT_CONTEXT_WINDOW=32768
# M365_AUTO_CONTEXT_COMPRESSION=true
# TEST_PATCH_MARKER=1
# M365_MAX_OUTPUT_TOKENS=16384
# M365_CHAT_TIMEOUT_SECONDS=120
# M365_IMAGE_TIMEOUT_SECONDS=150

# Proxy pool and proxy health checks.
# M365_PROXY_POOL=http://user:password@proxy.example.com:8080
# M365_PROXY_INSECURE_TLS=false
# M365_PROXY_HEALTH_URL=http://www.msftconnecttest.com/connecttest.txt

# Optional cache, key, usage, and debug file paths. Leave commented to use
# paths derived from M365_DATA_DIR.
# M365_TOKEN_CACHE=$HOME/.config/m365-copilot2api/token-cache.json
# M365_SESSION_CACHE=$HOME/.config/m365-copilot2api/sessions.json
# M365_CONVERSATION_CACHE=$HOME/.config/m365-copilot2api/conversations.json
# M365_API_KEYS=$HOME/.config/m365-copilot2api/api-keys.json
# M365_USAGE_LOG=$HOME/.config/m365-copilot2api/usage.jsonl
# M365_DEBUG_LOG=$HOME/.config/m365-copilot2api/debug.log

# Browser PKCE and Device Code OAuth can use independent app registrations.
# Legacy M365_CLIENT_ID / M365_AUTHORITY / M365_SCOPE remain fallbacks.
# M365_BROWSER_CLIENT_ID=your-browser-application-client-id
# M365_BROWSER_AUTHORITY=https://login.microsoftonline.com/common
# M365_BROWSER_SCOPE=openid profile offline_access
# M365_BROWSER_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient
# M365_DEVICE_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
# M365_DEVICE_AUTHORITY=https://login.microsoftonline.com/common
# M365_DEVICE_SCOPE=openid profile offline_access
# M365_CLIENT_ID=your-legacy-application-client-id
# M365_AUTHORITY=https://login.microsoftonline.com/common
# M365_SCOPE=openid profile offline_access
# M365_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient
# Docker Compose host binding. Keep 127.0.0.1 for local/reverse-proxy access;
# use 0.0.0.0:4141 only when direct external access is required.
M365_DOCKER_PORT=127.0.0.1:4141

# Optional image build metadata.
M365_VERSION=dev
M365_COMMIT=unknown
M365_BUILD_TIME=unknown

# Go module proxy used while building the Docker image. The fallback chain
# continues when a proxy is unavailable; override it if your network requires
# an internal proxy, for example: GOPROXY=https://proxy.example.com,direct
GOPROXY=https://goproxy.cn|https://proxy.golang.org|direct
